---
import dev from '../data/dev.json';
---
<!-- the dev's tag: handle goes to Instagram, then GitHub, then Spotify (shown once a link is set in dev.json) -->
<div class="devtag glass" transition:persist="devtag">
  <span class="devtag__label">dev</span>
  <a class="devtag__handle" href={dev.instagram} target="_blank" rel="noopener" aria-label={`@${dev.handle} on Instagram`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"/></svg>
    <span>@{dev.handle}</span>
  </a>
  <a class="devtag__icon" href={dev.github} target="_blank" rel="noopener" aria-label="Source code on GitHub">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
  </a>
  {dev.spotify && (
    <a class="devtag__icon" href={dev.spotify} target="_blank" rel="noopener" aria-label={`@${dev.handle}'s jams on Spotify`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 1a11 11 0 1 0 0 22 11 11 0 0 0 0-22Zm5.04 15.87a.69.69 0 0 1-.94.23c-2.58-1.58-5.83-1.93-9.66-1.06a.69.69 0 1 1-.3-1.34c4.19-.96 7.79-.55 10.67 1.22.32.2.43.62.23.95Zm1.35-3a.86.86 0 0 1-1.18.28c-2.95-1.81-7.45-2.34-10.94-1.28a.86.86 0 1 1-.5-1.65c3.99-1.21 8.95-.62 12.34 1.46.4.25.53.78.28 1.19Zm.12-3.12C14.97 8.65 9.13 8.46 5.76 9.48a1.03 1.03 0 1 1-.6-1.97c3.87-1.17 10.3-.95 14.36 1.46a1.03 1.03 0 0 1-1.01 1.78Z"/></svg>
    </a>
  )}
</div>
