---
import stations from '../data/station.json';
const { scene } = Astro.props;
const station = stations.find((s) => s.id === scene.station) ?? stations[0];
---
<!-- each scene plays the station that fits its vibe; scenes on the same station keep the
     same player element, so the music carries on when you switch between them -->
<div class="player" transition:persist={`player-${station.id}`}>
  <iframe
    title={`Spotify player: ${station.label}`}
    src={`https://open.spotify.com/embed/playlist/${station.playlist}?utm_source=generator&theme=0`}
    width="100%"
    height="152"
    frameborder="0"
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
    loading="lazy">
  </iframe>
</div>
