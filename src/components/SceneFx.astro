---
// ambient particles over the art: highway dust, monsoon rain, or drifting light motes
const { fx } = Astro.props;
---
<canvas class="stage__fx" data-fx={fx} aria-hidden="true"></canvas>

<script>
  type Particle = { x: number; y: number; vx: number; vy: number; r: number; a: number; t: number };

  let raf = 0;
  let stopPointer: (() => void) | undefined;

  function run() {
    cancelAnimationFrame(raf);
    stopPointer?.();

    const canvas = document.querySelector<HTMLCanvasElement>('.stage__fx');
    const stage = document.querySelector<HTMLElement>('.stage');
    if (!canvas || !stage) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const kind = canvas.dataset.fx || 'motes';
    const ctx = canvas.getContext('2d')!;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let w = 0, h = 0;

    const resize = () => {
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();

    const count = kind === 'rain' ? Math.round(w / 6) : Math.round(w / 22);
    const spawn = (anywhere: boolean): Particle => {
      const p: Particle = { x: Math.random() * w, y: anywhere ? Math.random() * h : -20, vx: 0, vy: 0, r: 0, a: 0, t: Math.random() * 1000 };
      if (kind === 'rain') {
        p.vx = -1.2; p.vy = 9 + Math.random() * 7; p.r = 10 + Math.random() * 14; p.a = 0.18 + Math.random() * 0.25;
      } else if (kind === 'dust') {
        p.y = anywhere ? h * 0.45 + Math.random() * h * 0.55 : h + 10;
        p.vx = 0.25 + Math.random() * 0.6; p.vy = -(0.1 + Math.random() * 0.35); p.r = 0.8 + Math.random() * 2.2; p.a = 0.25 + Math.random() * 0.5;
      } else {
        p.y = anywhere ? Math.random() * h : h + 10;
        p.vx = (Math.random() - 0.5) * 0.3; p.vy = -(0.15 + Math.random() * 0.35); p.r = 1.5 + Math.random() * 3.5; p.a = 0.15 + Math.random() * 0.35;
      }
      return p;
    };
    const parts = Array.from({ length: count }, () => spawn(true));

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      for (let i = 0; i < parts.length; i++) {
        const p = parts[i];
        p.t += 0.016;
        p.x += p.vx + (kind === 'rain' ? 0 : Math.sin(p.t) * 0.2);
        p.y += p.vy;
        if (p.y > h + 30 || p.y < -30 || p.x > w + 30 || p.x < -30) { parts[i] = spawn(false); continue; }
        if (kind === 'rain') {
          ctx.strokeStyle = `rgba(220, 240, 255, ${p.a})`;
          ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(p.x + p.vx * 2, p.y - p.r); ctx.stroke();
        } else {
          const flicker = kind === 'dust' ? 1 : 0.6 + Math.sin(p.t * 2) * 0.4;
          const color = kind === 'dust' ? '255, 190, 120' : '255, 244, 214';
          ctx.fillStyle = `rgba(${color}, ${p.a * flicker})`;
          ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill();
        }
      }
      raf = requestAnimationFrame(draw);
    };
    draw();

    // parallax: the art leans a little toward the pointer
    const onMove = (e: PointerEvent) => {
      if (e.pointerType !== 'mouse') return;
      stage.style.setProperty('--px', ((e.clientX / innerWidth) - 0.5).toFixed(3));
      stage.style.setProperty('--py', ((e.clientY / innerHeight) - 0.5).toFixed(3));
    };
    addEventListener('pointermove', onMove);
    addEventListener('resize', resize);
    stopPointer = () => { removeEventListener('pointermove', onMove); removeEventListener('resize', resize); };
  }

  document.addEventListener('astro:page-load', run);
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) cancelAnimationFrame(raf); else run();
  });
</script>
