---
import stations from '../data/station.json';
import DevTag from './DevTag.astro';
import SceneFx from './SceneFx.astro';
const { scene } = Astro.props;
---
<main class="stage" style={`--tint:${scene.tint}; --focus:${scene.focus};`}>
  <div class="stage__art" transition:name="art" transition:animate="fade">
    <img class="stage__bg" src={scene.bg} alt="" />
  </div>
  <SceneFx fx={scene.fx} />
  <div class="stage__tint" aria-hidden="true"></div>
  <div class="stage__grain" aria-hidden="true"></div>
  <div class="stage__vignette" aria-hidden="true"></div>

  <header class="topbar">
    <a class="brand glass" href="/truck-wala/" aria-label="Vibe Radio home">
      <span class="brand__dot" aria-hidden="true"></span>
      <span class="brand__name">Vibe Radio</span>
      <span class="brand__era">Kishore era</span>
    </a>
    <DevTag />
    <div class="status glass" aria-live="off">
      <span id="clock"></span>
      <span class="status__sep" aria-hidden="true">·</span>
      <span class="status__live"><span class="status__dot" aria-hidden="true"></span><span id="listener-count">{scene.baseListeners}</span> {scene.statusLabel}</span>
    </div>
  </header>

  <section class="card glass" transition:name="card">
    <p class="card__eyebrow">{scene.subtitle}</p>
    <h1 class="card__title">{scene.title}</h1>
    <p class="card__caption">{scene.caption}</p>
    <p class="card__meta">
      <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="card__spinning">Now spinning: {(stations.find((s) => s.id === scene.station) ?? stations[0]).label}</span>
      <a href={scene.credit.url} target="_blank" rel="noopener">{scene.credit.label}</a>
    </p>
  </section>

  <slot />
</main>

<script>
  let driftTimer: ReturnType<typeof setInterval> | undefined;
  let clockTimer: ReturnType<typeof setInterval> | undefined;

  function tick() {
    const el = document.getElementById('clock');
    if (!el) return;
    const now = new Date();
    let h = now.getHours();
    const m = now.getMinutes().toString().padStart(2, '0');
    const ampm = h >= 12 ? 'pm' : 'am';
    h = h % 12; if (h === 0) h = 12;
    el.textContent = `${h}:${m} ${ampm}`;
  }

  function start() {
    clearInterval(driftTimer);
    clearInterval(clockTimer);
    tick();
    clockTimer = setInterval(tick, 15000);

    // fake-but-believable live listener drift, client-side only, no backend needed
    const countEl = document.getElementById('listener-count');
    if (!countEl) return;
    let base = parseInt(countEl.textContent || '0', 10);
    driftTimer = setInterval(() => {
      const drift = Math.floor(Math.random() * 5) - 2; // -2..+2
      base = Math.max(3, base + drift);
      countEl.textContent = String(base);
    }, 4000);
  }

  // re-run after every client-side scene switch
  document.addEventListener('astro:page-load', start);
</script>
