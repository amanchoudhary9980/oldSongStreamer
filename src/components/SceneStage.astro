---
const { scene } = Astro.props;
---
<div class="stage" style={`--warm:${scene.warm}; --cool:${scene.cool};`}>
  <img class="stage__bg" src={scene.bg} alt={scene.title} />
  <div class="stage__grain"></div>
  <div class="stage__vignette"></div>

  <div class="stage__topbar">
    <span id="clock"></span>
    <span class="stage__status">
      <span class="stage__dot"></span>
      <span id="listener-count">{scene.baseListeners}</span>
      <span>{scene.statusLabel}</span>
    </span>
    <span style="width: 24px;"></span>
  </div>

  <h1 class="stage__title">{scene.title}</h1>
  <p class="stage__caption">{scene.caption}</p>

  <slot />
</div>

<script>
  function tick() {
    const el = document.getElementById('clock');
    if (!el) return;
    const now = new Date();
    let h = now.getHours();
    const m = now.getMinutes().toString().padStart(2, '0');
    const ampm = h >= 12 ? 'pm' : 'am';
    h = h % 12; if (h === 0) h = 12;
    el.textContent = `${h}:${m} ${ampm}`;
  }
  tick();
  setInterval(tick, 15000);

  // fake-but-believable live listener drift, client-side only, no backend needed for v1
  const countEl = document.getElementById('listener-count');
  if (countEl) {
    let base = parseInt(countEl.textContent || '0', 10);
    setInterval(() => {
      const drift = Math.floor(Math.random() * 5) - 2; // -2..+2
      base = Math.max(3, base + drift);
      countEl.textContent = String(base);
    }, 4000);
  }
</script>
